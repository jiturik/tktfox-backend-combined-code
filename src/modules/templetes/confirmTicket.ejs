<!DOCTYPE html>
<html>
<head>
<style>
 html {
        zoom: 0.6;
   }
table {
  font-family: arial, sans-serif;
  border-collapse: collapse;
  width: 100%;
}

td, th {
 border: 4px solid #dddddd;
padding:8px;
margin:0
}
 .container {
        margin: auto;

        background-color: #fff;
        padding: 20px;
     
        width: 80%;
        border-radius: 8px;
      }
      
         .header {
         text-align:center;
        font-size: 20px;
        color: green;
        margin-bottom: 20px;
        font-weight: bold;
      }

</style>
</head>
<body>


<div class="container">
 <div class="header">Your booking is confirmed!</div>
<table>
  <tr>
    <th colspan="2">ORDER DETAILS</th>
  </tr>
  <tr>
    <td >          <h4>Customer Name : <%= emailData.c_name %></h4>
          <h4>Booking ID : <%= emailData.booking_code %></h4>
          <h4>Event : <%= emailData.event_name %></h4>
          <h4>Seat : <%= emailData.seats %></h4></td>
    <td style="text-align:center" rowspan=3>    <p> <img
        
            width="200"
            height="200"
            src="<%- emailData.qrcode_data %>"
            alt="qr code"
          /></p> <p><%= emailData.booking_code %></p></td>
  
  </tr>
  <tr >
    <td  style="text-align:center"><h3>Order Total</h3><h4 class="text-muted"> <%= emailData.totalPrice %> <%= emailData.currency %></4></td>
  </tr>
  <tr >
    <td ><p>Transaction Date Time : <%= emailData.booking_date_time %></p><p>Payment Method : PAYONE</p></td>
  

  </tr>
  <tr >
    <td colspan="2" style="text-align:center;background:red"><p> See you there on</p><h3><%= emailData.event_date_time %></h3></td>
    
   
  </tr>
 
</table>

<div> <%- emailData.event_tnc %></div>
</div>

</body>
</html>

